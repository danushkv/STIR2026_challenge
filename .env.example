# Copy this file to .env and replace the example paths. Shell drivers load
# .env automatically; it is ignored by Git.

# Source datasets and generated artifacts.
DATA_ROOT=/absolute/path/to/stir-data
STIR_TRAIN_ROOT=/absolute/path/to/stir-data/STIRcombined
STIR_TEST_ROOT=/absolute/path/to/stir-data/STIRTest_2025
PSEUDO_LABELS_DIR=/absolute/path/to/stir-data/STIRprocessed/pseudo_labels_with_2024_agg
RAW_TRACKS=/absolute/path/to/stir-data/STIRprocessed/STIROrig_tracks
RUNS_ROOT=/absolute/path/to/stir-data/STIRprocessed/model_runs
EVAL_ROOT=/absolute/path/to/stir-data/STIRprocessed/eval_sweep

# Upstream clones. By default, scripts look for these next to this repository.
THIRDPARTY_ROOT=/absolute/path/to/third-party-clones
COTRACKER_ROOT=/absolute/path/to/third-party-clones/co-tracker
STIRLOADER_ROOT=/absolute/path/to/third-party-clones/STIRLoader
LITETRACKER_ROOT=/absolute/path/to/third-party-clones/lite-tracker-master
STIR_INFERENCE_ROOT=/absolute/path/to/third-party-clones/stir-challenge-2026-inference
STIR_METRICS_ROOT=/absolute/path/to/third-party-clones/stir-challenge-2026-metrics

# Python executables. MFT needs its own incompatible environment.
PYTHON_BIN=/absolute/path/to/trackon_env/bin/python
MFT_PYTHON=/absolute/path/to/mft_env/bin/python

# Checkpoints.
INIT_CKPT=/absolute/path/to/litetracker_finetuned.pth
STUDENT_CHECKPOINT=/absolute/path/to/student.pth
